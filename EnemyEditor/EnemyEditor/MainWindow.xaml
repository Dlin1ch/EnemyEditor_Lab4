<Window x:Class="EnemyEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EnemyEditor"
        mc:Ignorable="d"
        Title="Редактор противников" Height="700" Width="900">
    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Левая колонка: список противников и поля ввода -->
            <ColumnDefinition Width="300"/>
            <!-- Центральная колонка: иконки -->
            <ColumnDefinition Width="250"/>
            <!-- Правая колонка: главная иконка -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ЛЕВАЯ КОЛОНКА -->
        <StackPanel Grid.Column="0" Margin="10">
            <Label Content="Список противников:" FontWeight="Bold"/>
            <ListBox x:Name="EnemiesListBox" Height="150" Margin="0,5,0,10" SelectionChanged="EnemiesListBox_SelectionChanged"/>

            <Label Content="Имя противника:"/>
            <TextBox x:Name="EnemyNameTextBox" Margin="0,2,0,5"/>

            <Label Content="Имя иконки:"/>
            <TextBox x:Name="IconNameTextBox" Margin="0,2,0,5" IsReadOnly="True"/>

            <Label Content="Базовое здоровье:"/>
            <TextBox x:Name="BaseLifeTextBox" Margin="0,2,0,5"/>

            <Label Content="Модификатор здоровья:"/>
            <TextBox x:Name="LifeModifierTextBox" Margin="0,2,0,5"/>

            <Label Content="Базовое золото:"/>
            <TextBox x:Name="BaseGoldTextBox" Margin="0,2,0,5"/>

            <Label Content="Модификатор золота:"/>
            <TextBox x:Name="GoldModifierTextBox" Margin="0,2,0,5"/>

            <Label Content="Шанс появления:"/>
            <TextBox x:Name="SpawnChanceTextBox" Margin="0,2,0,10"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="AddButton" Content="Добавить" Width="80" Height="30" Margin="0,0,5,0" Click="AddButton_Click"/>
                <Button x:Name="EditButton" Content="Редактировать" Width="100" Height="30" Margin="0,0,5,0" Click="EditButton_Click"/>
                <Button x:Name="RemoveButton" Content="Удалить" Width="80" Height="30" Click="RemoveButton_Click"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                <Button x:Name="SaveButton" Content="Сохранить" Width="80" Height="30" Margin="0,0,5,0" Click="SaveButton_Click"/>
                <Button x:Name="LoadButton" Content="Загрузить" Width="80" Height="30" Click="LoadButton_Click"/>
                <Button x:Name="PlayButton" Content="Играть" Width="80" Height="30" Margin="5,0,0,0" Click="PlayButton_Click"/>
            </StackPanel>
        </StackPanel>

        <!-- ЦЕНТРАЛЬНАЯ КОЛОНКА -->
        <StackPanel Grid.Column="1" Margin="10">
            <Label Content="Иконки:" FontWeight="Bold"/>
            <Button x:Name="LoadIconsButton" Content="Загрузить иконки" Height="30" Margin="0,5,0,5" Click="LoadIconsButton_Click"/>
            <ListBox x:Name="IconsListBox" Height="450" SelectionChanged="IconsListBox_SelectionChanged"/>
        </StackPanel>

        <!-- ПРАВАЯ КОЛОНКА -->
        <StackPanel Grid.Column="2" Margin="10">
            <Label Content="Выбранная иконка:" FontWeight="Bold"/>
            <Image x:Name="MainEnemyIcon" Width="128" Height="128" Margin="0,10,0,0"/>
        </StackPanel>
    </Grid>
</Window>
